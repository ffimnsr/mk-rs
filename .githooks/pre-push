#!/usr/bin/env bash

set -euo pipefail

remote="$1"
url="$2"

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

source "$repo_root/.githooks/rust-check-scope.sh"

zero="$(git hash-object --stdin </dev/null | tr '[0-9a-f]' '0')"
should_run_checks=0

while read -r local_ref local_oid remote_ref remote_oid; do
    if [[ "$local_oid" == "$zero" ]]; then
        continue
    fi

    if [[ "$remote_oid" == "$zero" ]]; then
        commit_selector=("$local_oid" "--not" "--remotes=$remote")
    else
        commit_selector=("$remote_oid..$local_oid")
    fi

    commit="$(git rev-list -n 1 --grep '^--wip--' "${commit_selector[@]}")"
    if [[ -n "$commit" ]]; then
        echo >&2 "Found WIP commit in $local_ref, not pushing."
        exit 1
    fi

    reset_check_scope
    collect_check_scope < <(
        git rev-list "${commit_selector[@]}" |
            git diff-tree --stdin --no-commit-id --name-only -r |
            sort -u
    )

    if [[ "$needs_rust_checks" -eq 1 ]]; then
        should_run_checks=1
        break
    fi
done

if [[ "$should_run_checks" -eq 0 && "${MK_PRE_PUSH_FULL:-0}" != "1" ]]; then
    echo "[pre-push] no Rust changes in commits being pushed; skipping cargo checks"
    exit 0
fi

build_scope_args "${MK_PRE_PUSH_FULL:-0}"

if [[ "${#scope_args[@]}" -eq 0 ]]; then
    scope_args=(--workspace)
fi

echo "[pre-push] format check"
cargo fmt --all --check

echo "[pre-push] lint (${scope_args[*]})"
cargo clippy "${scope_args[@]}" --all-features --all-targets --tests --benches -- -Dclippy::all

exit 0
